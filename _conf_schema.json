{
  "emoji_follow_prob": {
    "description": "表情跟随概率",
    "hint": "用户的消息中含有表情时，bot将按概率自动为这条消息贴上对应的表情",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.001
    },
    "default": 0.3
  },
  "emoji_like_prob": {
    "description": "对消息贴表情的概率",
    "hint": "太高群友会烦，太低难触发（唤醒消息自动忽略）。",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.001
    },
    "default": 0.03
  },
  "judge_provider_id": {
    "description": "判断情感用的LLM提供商",
    "type": "string",
    "default": "",
    "hint": "判断情感用的 LLM 服务商；留空用系统默认。建议用稳定的小模型。",
    "_special": "select_provider"
  },
  "judge_backend": {
    "description": "情感判断的后端",
    "type": "string",
    "hint": "llm＝调用 LLM 判断（默认）；jev＝只用 Jev 决策模型；hybrid＝Jev 先判，把握不足再回落 LLM。",
    "options": [
      "llm",
      "jev",
      "hybrid"
    ],
    "labels": [
      "LLM 判断（默认）",
      "Jev 决策模型",
      "Jev 优先 + LLM 兜底"
    ],
    "default": "llm"
  },
  "emotions_mapping_list": {
    "description": "情感映射表",
    "hint": "情感关键词 → 表情 ID（列表模式编辑）。查 ID 可用 astrbot_plugin_multimsg 的 face <ID范围>。",
    "type": "list",
    "default": [
      "开心：2 74 109 272 295 305 318 319 324 339",
      "得意：4 16 28 29 99 101 178 269 270 277 283 299 307 336 426",
      "害羞：6 20 21",
      "难过：5 34 35 36 37 173 264 265 267 425",
      "纠结：106 176 262 263 270",
      "生气：11 26 31 105",
      "惊讶：3 325",
      "疑惑：32 268",
      "恳求：111 353",
      "可怕：1 286",
      "尴尬：100 306 342 344 347",
      "无语：46 97 181 271 281 284 287 312 352 357 427",
      "恶心：19 59 323",
      "无聊：8 25 285 293"
    ]
  },
  "emoji_interval": {
    "description": "贴表情的时间间隔（秒）",
    "hint": "贴多个表情时，每个表情之间的时间间隔，适当间隔比较自然，符合真人感",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 3,
      "step": 0.1
    },
    "default": 0.4
  },
  "jev_judge": {
    "type": "object",
    "description": "[Jev 判断] Jev 决策模型设置",
    "hint": "仅在「情感判断的后端」选 jev/hybrid 时生效。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用 Jev 判断",
        "hint": "总开关，关闭时只走 LLM。",
        "default": false
      },
      "api_key": {
        "type": "string",
        "description": "Jev API Key",
        "hint": "sk- 开头，在所选网关的控制台创建。",
        "default": ""
      },
      "base_url": {
        "type": "string",
        "description": "Jev 接口地址",
        "hint": "网关根地址。可选：jevmodel.org（官方）、api.typesafe.ai、jevtypesafeai.com（第三方代理）。",
        "default": "https://jevmodel.org"
      },
      "api_format": {
        "type": "string",
        "description": "接口协议",
        "hint": "systemone＝官方 Jev/TypeSafe；decisions＝OpenAI Decisions。部分中转站用后者。",
        "options": [
          "systemone",
          "decisions"
        ],
        "labels": [
          "SystemOne（/v1/systemone）",
          "OpenAI Decisions（/v1/decisions）"
        ],
        "default": "systemone"
      },
      "endpoint_path": {
        "type": "string",
        "description": "端点路径",
        "hint": "留空＝按「接口协议」自动拼。jevtypesafeai.com 用 /api/v1/decide。",
        "default": ""
      },
      "model": {
        "type": "string",
        "description": "Jev 模型名",
        "hint": "默认 jev-latest；jev-preview 支持图像输入（实验性）。",
        "default": "jev-latest"
      },
      "timeout_sec": {
        "type": "float",
        "description": "请求超时（秒）",
        "hint": "本轮所有尝试共享的总预算，建议 5-10 秒。",
        "default": 8.0
      },
      "retries": {
        "type": "int",
        "description": "失败重试次数",
        "hint": "限流或上游故障时重试。",
        "default": 1
      },
      "gate_mode": {
        "type": "string",
        "description": "置信度门控方式",
        "hint": "threshold＝达到阈值才采信 Jev；sample＝按把握概率抽样采信。",
        "options": [
          "threshold",
          "sample"
        ],
        "labels": [
          "按阈值（可复现）",
          "按概率抽样（平滑）"
        ],
        "default": "threshold"
      },
      "prompt_language": {
        "type": "string",
        "description": "提示词语言",
        "hint": "auto＝跟随内容语言；zh/en＝固定。",
        "options": [
          "auto",
          "zh",
          "en"
        ],
        "labels": [
          "自动（跟随内容语言）",
          "固定中文",
          "固定英文"
        ],
        "default": "auto"
      },
      "min_confidence": {
        "type": "float",
        "description": "采信阈值",
        "hint": "threshold 模式下：Jev 选中那档的概率达到该值才采信。",
        "default": 0.6
      },
      "max_state_chars": {
        "type": "int",
        "description": "发送上下文长度上限",
        "hint": "超出部分从最旧的内容开始丢。",
        "default": 1200
      }
    }
  }
}
